#!/bin/bash
# corral-light — pair a client, or run the server.
#   corral-light pair ABC-123   authorize the browser showing that code
#                               (--break-glass: even under key-only; audited)
#   corral-light key list|enroll|rm <id>|policy <p>|recover <code> <id>|--all
#                               security keys for pairing (key_cli.py)
#   corral-light serve          run the hub in the foreground
#   corral-light doctor         say which lanes can start here, and why not
#   corral-light launch         open the wall in your browser, already paired
#                               (--print: show the URL, open nothing)
#   corral-light install-service  write this checkout's systemd unit (Linux) or
#                               launchd plist (macOS) with the paths resolved.
#                               It does NOT enable or start anything — the
#                               enable command is printed for you to run.
#                               --print shows the file and writes nothing.
#   corral-light diagnose       run one lane end to end and report everything
#   corral-light consult ...    ask a lane from a script — the assistant's way to
#                               get a second opinion on your subscriptions, not
#                               an API key (consult.py --help for the verbs)
#   corral-light watch          probe the hub from OUTSIDE it; page (STATE/DEAD +
#                               a desktop notification) when it is down or its
#                               observer stalled. Never restarts it. Run by the
#                               corral-light-watch timer (README).
#   corral-light watch <pane>   ...with a pane id: follow that pane live (cli.py)
#   corral-light panes | open | say | pending | ok | no | cancel | pause |
#                resume | close | forget | reopen | rename | seat | config |
#                attach | quote     the whole pane surface from a terminal
#   corral-light rig save|up|list|rm <name>   saved seats
#   corral-light worktrees [list|restore|purge|resolve]   own-branch worktrees:
#                               list them (read only), restore a discarded one,
#                               purge one for good (typed branch name), settle an
#                               action with an unknown outcome (worktrees_cli.py)
#   corral-light update [--check|--now|--wait S]   bring this install up to date
#                               with its repository; restarts the hub only when no
#                               pane is mid-turn or waiting (update.py --help)
#   corral-light lanes check [--job]   installed against latest per lane (read only;
#                               --job = edge-triggered notices for a scheduler)
#   corral-light module add|list|show|run|enable|disable|update|rollback|remove
#                               installed modules, each its own repository, run
#                               sandboxed (modules.py; docs/finops-module-plan.md)
#   corral-light hubs ...       link other Corral Light hubs: see what they are
#                               working on, take work over, offer work (hubs_cli.py)
#   corral-light <module> ...   an enabled module's own commands (e.g. finops setup)
#   corral-light lanes update <lane>   stage a lane's newer adapter, prove it on a
#                               private hub, and only then move its pin (lanes.py)
#                               (cli.py --help; `say` answers permissions in
#                               the same terminal and never cancels on a timer)
#
# /bin/bash, not /usr/bin/bash: macOS has no /usr/bin/bash.
set -euo pipefail
D="$(cd "$(dirname "$0")" && pwd)"
PY="${CORRAL_LIGHT_PYTHON:-python3}"
case "${1:-}" in
  pair|key) exec "$PY" "$D/key_cli.py" "$@" ;;
  serve) exec "$PY" "$D/hub.py" ;;
  doctor) exec "$PY" "$D/doctor.py" ;;
  worktrees) shift; exec "$PY" "$D/worktrees_cli.py" "$@" ;;
  hubs) shift; exec "$PY" "$D/hubs_cli.py" "$@" ;;
  launch) shift; exec "$PY" "$D/launch.py" "$@" ;;
  install-service) shift; exec "$PY" "$D/install_service.py" "$@" ;;
  diagnose) shift; exec "$PY" "$D/diagnose.py" "$@" ;;
  consult) shift; exec "$PY" "$D/consult.py" "$@" ;;
  watch)
    # With a pane id: follow that pane (cli.py); bare or --flags: hub watcher (watch.py).
    if [ $# -ge 2 ] && [[ "$2" != -* ]]; then exec "$PY" "$D/cli.py" "$@"; fi
    shift; exec "$PY" "$D/watch.py" "$@" ;;
  panes|open|say|pending|ok|no|cancel|pause|resume|close|forget|reopen|rename|seat|config|attach|quote|later|search|digest|port|rig)
    exec "$PY" "$D/cli.py" "$@" ;;
  lanes) shift; exec "$PY" "$D/lanes.py" "$@" ;;
  update) shift; exec "$PY" "$D/update.py" "$@" ;;
  cli) shift; exec "$PY" "$D/cli.py" "$@" ;;
  module|modules) shift; exec "$PY" "$D/modules.py" "$@" ;;
  *)
    # An enabled module's own verb (docs/finops-module-plan.md M7): only the
    # exact name of an enabled module, verified, never a core verb.
    if [ -n "${1:-}" ]; then
      set +e; "$PY" "$D/modules.py" --dispatch "$@"; rc=$?; set -e
      [ "$rc" -ne 2 ] && exit "$rc"
    fi
    echo "usage: corral-light {pair [--break-glass] <code>|key <list|enroll|rm|policy|recover>|serve|doctor|launch [--print]|install-service [--print]|diagnose [lane]|consult <verb> ...|watch [pane]|panes|open|say|pending|ok|no|cancel|pause|resume|close|forget|reopen|rename|config|attach|quote|rig <save|up|list|rm>|lanes check|lanes update <lane>|update [--check]|module <add|list|show|run|enable|disable|update|rollback|remove|doctor>|<enabled module> ...}"; exit 2 ;;
esac
