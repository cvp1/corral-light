# Corral Light — systemd USER unit, for a Linux box.
# (The macOS equivalent is com.cvp1.corral-light.plist.)
#
# Install:
#   mkdir -p ~/.config/systemd/user
#   sed "s|%HERE%|$PWD|" corral-light.service > ~/.config/systemd/user/corral-light.service
#   systemctl --user daemon-reload && systemctl --user enable --now corral-light
#   systemctl --user status corral-light
#
# On a headless box you also want the unit to survive logout:
#   loginctl enable-linger $USER
#
# A user unit, not a system service: every lane authenticates as the
# logged-in user, and running as root would put a root shell behind the
# pairing gate.

[Unit]
Description=Corral Light — multi-model agent workspace
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 %HERE%/hub.py
WorkingDirectory=%HERE%

# Loopback by default; set 0.0.0.0 only on a trusted LAN.
Environment=CORRAL_LIGHT_BIND=127.0.0.1
Environment=CORRAL_LIGHT_PORT=8098
Environment=CORRAL_OLLAMA_URL=http://127.0.0.1:11434

Restart=always
RestartSec=3

# mixed: SIGTERM reaches the hub alone first, so it can note interrupted turns
# in busy panes before systemd kills the agents in the cgroup.
KillMode=mixed

[Install]
WantedBy=default.target
