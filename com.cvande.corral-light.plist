<?xml version="1.0" encoding="UTF-8"?>
<!--
  Corral Light — launchd user agent (macOS).

  Install:
    cp com.cvande.corral-light.plist ~/Library/LaunchAgents/
    launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.cvande.corral-light.plist
    launchctl kickstart -k gui/$(id -u)/com.cvande.corral-light   # after an edit

  A user agent, not a system daemon: every lane authenticates as the
  logged-in user, and running as root would put a root shell behind the
  pairing gate.

  Do not point this at a git worktree: spike/node_modules/ is gitignored, so
  the Claude and ChatGPT lanes would be unavailable. To try a branch, run
  hub.py in the foreground from that checkout with CORRAL_LIGHT_PORT=8099.

  Paths are absolute because launchd inherits almost no environment.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cvande.corral-light</string>

  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>/Users/craigvandeputte/corral-light/hub.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/craigvandeputte/corral-light</string>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- Loopback by default. Reach it remotely with
         `ssh -N -L 8098:127.0.0.1:8098 <host>` (also a secure context for the
         PWA install prompt). Set 0.0.0.0 only on a trusted LAN. -->
    <key>CORRAL_LIGHT_BIND</key>
    <string>127.0.0.1</string>
    <key>CORRAL_LIGHT_PORT</key>
    <string>8098</string>
    <!-- Ollama endpoint; point elsewhere if this host does not hold the models. -->
    <key>CORRAL_OLLAMA_URL</key>
    <string>http://127.0.0.1:11434</string>
    <!-- Homebrew node for the npm-installed ACP adapters; launchd's default
         PATH lacks it. -->
    <key>PATH</key>
    <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/craigvandeputte/Library/Logs/corral-light.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/craigvandeputte/Library/Logs/corral-light.log</string>
</dict>
</plist>
